<%@ page language="java"
    contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>InterviewX - Home</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f8fafc;
            color: #0f172a;
        }

        .navbar {
            background: #0f172a;
            color: white;
            padding: 20px 50px;
            font-size: 24px;
            font-weight: bold;
        }

        .hero {
            text-align: center;
            padding: 100px 20px;
        }

        .hero h1 {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 19px;
            color: #64748b;
        }

        .card {
            width: 80%;
            max-width: 800px;
            margin: 40px auto;
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            text-align: center;
        }

        .success {
            color: #16a34a;
            font-weight: bold;
        }

    </style>

</head>

<body>

    <div class="navbar">
        InterviewX 🚀
    </div>

    <section class="hero">

        <h1>Welcome to InterviewX</h1>

        <p>
            AI-Powered Personalized Placement Preparation Platform
        </p>

    </section>

    <div class="card">

        <h2>Servlet → JSP Communication</h2>

        <p class="success">
            ✓ Working Successfully
        </p>

        <p>
            HomeServlet successfully forwarded the request
            to home.jsp.
        </p>

    </div>

</body>

</html>